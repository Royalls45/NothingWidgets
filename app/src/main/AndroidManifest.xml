        <receiver android:name=".WaterWidget" android:exported="true" android:label="Glyph Water"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_water" /></receiver>
        <receiver android:name=".QuoteWidget" android:exported="true" android:label="Glyph Quote"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quote" /></receiver>
