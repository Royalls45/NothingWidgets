        <receiver android:name=".MetroClockWidget" android:exported="true" android:label="Glyph Metro Clock"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_metro" /></receiver>
        <receiver android:name=".OrbitClockWidget" android:exported="true" android:label="Glyph Orbit Clock"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_orbit" /></receiver>
